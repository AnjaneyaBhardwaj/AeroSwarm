# Copy to deploy/.env and fill in. deploy/.env is git-ignored: never commit it.

# The subdomain, pointed at this server by a DNS A record (no https://, no trailing slash).
DOMAIN=aeroswarm.example.com

# Anthropic API key for real-Claude runs. Leave empty to offer replays and mock runs only.
ANTHROPIC_API_KEY=

# Code you give people so they can start a real-Claude run. Required: the server will not start without it.
# Use something long and random, e.g. the output of: openssl rand -base64 18
AEROSWARM_LIVE_ACCESS_CODE=

# Estimated real-Claude spend allowed per UTC day, all visitors together (USD).
AEROSWARM_LIVE_DAILY_USD=10
